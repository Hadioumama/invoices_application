{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "cmake",
            "request": "launch",
            "name": "CMake: Configure project",
            "cmakeDebugType": "configure",
            "clean": false,
            "configureAll": false
        },
        {
            "name": "Déboguer FacturationApp",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/FacturationApp.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/Qt/QT/6.10.2/mingw1310_64/bin;C:/Qt/QT/Tools/mingw1310_64/bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/Qt/QT/Tools/mingw1310_64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Activer l'affichage structuré",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build"
        }
    ]
}
